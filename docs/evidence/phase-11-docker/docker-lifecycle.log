## 8. Remove the container, then recreate it from the same image and volume: data survives
$ docker rm -f ccrp-demo
ccrp-demo
$ docker ps -a --filter name=ccrp-demo --format '{{.Names}}' | wc -l
0
$ docker run -d --name ccrp-demo -p 8086:8080 -e APP_OFFICER_PASSWORD=******** -v ccrp-demo-data:/var/lib/ccrp sanad-ccrp:1.2.0-SNAPSHOT
fdba69529160dac131de15e9ced871a535a9524b63052dd26735a87943f76768
health: healthy
$ curl -s -X POST http://localhost:8086/api/v1/status -H 'Content-Type: application/json' -d '{"trackingId":"CCR-2026-WETB8V","email":"meera.iyer@example.com"}' | jq -c '{trackingId, status, certificateType}'
{"trackingId":"CCR-2026-WETB8V","status":"SUBMITTED","certificateType":"BIRTH"}

