# Recovery: the JVM is killed (simulated crash); systemd Restart=on-failure brings it back
$ systemctl show ccrp -p MainPID -p NRestarts -p ActiveState
MainPID=2468
NRestarts=0
ActiveState=active
$ kill -9 2468    # 16:32:15
$ curl http://localhost:8095/actuator/health   (immediately after the crash)
000
UP again after ~17s
$ systemctl show ccrp -p MainPID -p NRestarts -p ActiveState
MainPID=2645
NRestarts=1
ActiveState=active
$ journalctl -u ccrp (process events)
