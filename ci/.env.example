# Copy to ci/.env (or run scripts/ci-up.sh, which generates one). Never commit ci/.env.
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=change-me
TOMCAT_DEPLOYER_PASSWORD=change-me
APP_OFFICER_PASSWORD=change-me-too
CCRP_REPO_URL=https://github.com/tanishqbuilds/citizen-certificate-portal.git
# Optional: lets Jenkins publish commit statuses to GitHub. Leave as "none" to skip.
GITHUB_TOKEN=none
# Group id of /var/run/docker.sock on the host (stat -c %g /var/run/docker.sock)
DOCKER_GID=999
